# CentauroADS Links — Variables de entorno
# Copiar a .env (NO versionar) o definir en Easypanel.

# --- Panel de correos: sesion y primer acceso ------------------------------------------
# Firma las sesiones del panel. En PRODUCCION, definirla. Si falta, se genera una y se guarda en
# data/session.key: vale mientras esa carpeta no se pierda.
SESSION_SECRET=

# Correos que entran como administradores, separados por comas. Con la lista vacia NO ENTRA NADIE.
# Idempotente: a quien ya esta no lo toca, y no reactiva a quien se dio de baja.
PANEL_BOOTSTRAP=

# "Entrar con Google" (opcional). Sin ella solo se entra con contrasena y el boton no se muestra.
GOOGLE_CLIENT_ID=

# 1 = permite la sesion sin HTTPS. Solo para probar desde otro equipo de la red local por
# http://192.168... En localhost no hace falta. NUNCA en produccion.
COOKIE_INSEGURA=

# --- Acortador --------------------------------------------------------------------------
# Clave operativa del panel (cabecera X-Admin-Key).
# Si se deja vacia, el servicio genera una aleatoria al arrancar, la guarda en data/admin.key
# y la muestra una sola vez en el log.
ADMIN_KEY=

# Credencial de arranque: pone la PRIMERA contrasena a alguien de PANEL_BOOTSTRAP
# (POST /api/panel/arranque/contrasena) y cambia la clave del acortador desde la portada.
# Sin ellas esas rutas responden 503. No es un usuario del panel.
SUPERADMIN_USER=
SUPERADMIN_PASS=

# CORS: origenes propios que pueden llamar a la API desde el navegador, separados por comas.
# Vacio = ningun origen cruzado (el panel se sirve desde el mismo dominio). Nunca "*".
# Ejemplo: CORS_ORIGINS=https://centauroads.com
CORS_ORIGINS=

# Base de datos
DATABASE_URL=sqlite:///./data/centaurads_links.db
# PostgreSQL (opcional): DATABASE_URL=postgresql://user:pass@host:5432/centaurads_links

# --- Donde se guardan los datos (opcional) ----------------------------------------------
# Todo vive en data/: base de datos, claves generadas y entregas. En produccion, un volumen.
# DATA_DIR=data
# ADMIN_KEY_FILE=data/admin.key
# SESSION_SECRET_FILE=data/session.key
