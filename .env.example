# CentauroADS Links — Variables de entorno
# Copiar a .env (NO versionar) o definir en Easypanel.

# Clave operativa del panel (cabecera X-Admin-Key).
# Si se deja vacia, el servicio genera una aleatoria al arrancar, la guarda en data/admin.key
# y la muestra una sola vez en el log.
ADMIN_KEY=

# Credenciales master para cambiar la clave operativa desde la portada.
# Sin ellas, /api/superadmin/* responde 503.
SUPERADMIN_USER=
SUPERADMIN_PASS=

# CORS: origenes propios que pueden llamar a la API desde el navegador, separados por comas.
# Vacio = ningun origen cruzado (el panel se sirve desde el mismo dominio). Nunca "*".
# Ejemplo: CORS_ORIGINS=https://centauroads.com
CORS_ORIGINS=

# Base de datos
DATABASE_URL=sqlite:///./data/centaurads_links.db
# PostgreSQL (opcional): DATABASE_URL=postgresql://user:pass@host:5432/centaurads_links
